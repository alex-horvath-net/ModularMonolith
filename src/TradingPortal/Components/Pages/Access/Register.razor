@page "/access/register"
@rendermode InteractiveServer

@using System
@using System.Collections.Generic
@using Features.Accounts.Slices.Register

@inject Blazor.IGateway register

<PageTitle>Register</PageTitle>

<section class="container py-5">
    <div class="row align-items-center gy-3 mb-5">
        <div class="col-lg-8">
            <p class="text-uppercase text-muted mb-2 letter-spacing">Trading Portal</p>
            <h1 class="fw-bold display-6 mb-3">Provision Secure Trading Identity</h1>
            <p class="text-secondary mb-0">Submit institutional credentials to provision an identity that can later authenticate via the Security Officer workflow. Registration enforces bank-grade policies for email, password, and roles.</p>
        </div>
        <div class="col-lg-4 text-lg-end">
            <a class="btn btn-outline-primary btn-lg px-4" href="/access/login">Back to Login</a>
        </div>
    </div>

    <div id="RegistrationSuccess" class="alert alert-success @(string.IsNullOrWhiteSpace(successMessage) ? "d-none" : string.Empty)" role="alert" aria-live="polite">
        @successMessage
    </div>

    <div id="RegistrationError" class="alert alert-danger @(string.IsNullOrWhiteSpace(errorMessage) ? "d-none" : string.Empty)" role="alert" aria-live="assertive">
        @errorMessage
    </div>

    <div class="row gy-4">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-dark text-white fw-semibold">Registration Details</div>
                <div class="card-body">
                    <div class="mb-4">
                        <label class="form-label text-muted" for="Email">Institutional Email</label>
                        <input id="Email"
                               class="form-control form-control-lg"
                               type="email"
                               placeholder="trader@bank.com"
                               @bind-value="request.Email"
                               @bind-value:event="oninput"
                               autocomplete="email" />
                    </div>

                    <div class="mb-4">
                        <label class="form-label text-muted" for="UserName">Display Name</label>
                        <input id="UserName"
                               class="form-control form-control-lg"
                               type="text"
                               placeholder="Jane Trader"
                               @bind-value="request.UserName"
                               @bind-value:event="oninput" />
                    </div>

                    <div class="row g-4">
                        <div class="col-md-6">
                            <label class="form-label text-muted" for="Password">Password</label>
                            <input id="Password"
                                   class="form-control form-control-lg"
                                   type="password"
                                   placeholder="••••••••"
                                   @bind-value="request.Password"
                                   @bind-value:event="oninput"
                                   autocomplete="new-password" />
                            <small class="text-muted d-block mt-2">Minimum 12 characters with upper, lower, digit, and symbol.</small>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted" for="ConfirmPassword">Confirm Password</label>
                            <input id="ConfirmPassword"
                                   class="form-control form-control-lg"
                                   type="password"
                                   placeholder="••••••••"
                                   @bind-value="confirmPassword"
                                   @bind-value:event="oninput"
                                   autocomplete="new-password" />
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-dark text-white fw-semibold">Role Eligibility</div>
                <div class="card-body d-flex flex-column gap-3">
                    @foreach (var role in availableRoles)
                    {
                        <div class="form-check">
                            <input class="form-check-input"
                                   type="checkbox"
                                   id="role-@role"
                                   checked="@IsRoleSelected(role)"
                                   @onchange="args => ToggleRole(role, args.Value)" />
                            <label class="form-check-label fw-medium" for="role-@role">@role</label>
                        </div>
                    }

                    <small class="text-muted">At least one eligible role is required to provision an account.</small>

                    <button type="button"
                            class="btn btn-primary btn-lg mt-2"
                            disabled="@(!CanRegister)"
                            @onclick="OnRegisterClicked">
                        @(isSubmitting ? "Registering..." : "Create Identity")
                    </button>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .letter-spacing {
        letter-spacing: 0.25rem;
    }
</style>

@code {
    private Blazor.GatewayRequest request = new();
    private readonly HashSet<string> selectedRoles = new(StringComparer.OrdinalIgnoreCase);
    private readonly string[] availableRoles = ["Trader", "RiskManager", "Compliance"];
    private string confirmPassword = string.Empty;
    private string? successMessage;
    private string? errorMessage;
    private bool isSubmitting;

    private bool CanRegister => !isSubmitting
        && !string.IsNullOrWhiteSpace(request.Email)
        && !string.IsNullOrWhiteSpace(request.UserName)
        && !string.IsNullOrWhiteSpace(request.Password)
        && string.Equals(request.Password, confirmPassword, StringComparison.Ordinal)
        && selectedRoles.Count > 0;

    private bool IsRoleSelected(string role) => selectedRoles.Contains(role);

    private void ToggleRole(string role, object? value)
    {
        var isChecked = false;
        if (value is bool booleanValue)
        {
            isChecked = booleanValue;
        }
        else if (value is string stringValue)
        {
            if (string.Equals(stringValue, "on", StringComparison.OrdinalIgnoreCase))
            {
                isChecked = true;
            }
            else if (bool.TryParse(stringValue, out var parsed))
            {
                isChecked = parsed;
            }
        }

        if (isChecked)
        {
            selectedRoles.Add(role);
        }
        else
        {
            selectedRoles.Remove(role);
        }
    }

    private async Task OnRegisterClicked()
    {
        errorMessage = null;
        successMessage = null;

        if (!string.Equals(request.Password, confirmPassword, StringComparison.Ordinal))
        {
            errorMessage = "Passwords do not match.";
            return;
        }

        if (selectedRoles.Count == 0)
        {
            errorMessage = "Select at least one role.";
            return;
        }

        request.ReplaceRoles(selectedRoles);
        isSubmitting = true;
        try
        {
            var response = await register.Run(request);
            successMessage = $"Registration complete for {response.Email}.";
            request = new Blazor.GatewayRequest();
            confirmPassword = string.Empty;
            selectedRoles.Clear();
        }
        catch (Exception ex) when (ex is InvalidOperationException or ArgumentException)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
