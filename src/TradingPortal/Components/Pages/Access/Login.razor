@page "/access/login"
@rendermode InteractiveServer

@using TradingPortal.Components.Pages.Access
@using LoginClient = Experts.SecurityOfficer.Login.BlazorClient
@using Experts.SecurityOfficer.Shared.Domain

@inject UserContext UserContext
@inject LoginClient login

<PageTitle>Login</PageTitle>

<h1>Login</h1>

<button type="button" class="btn btn-primary" @onclick="OnLoginClicked">Login</button>

<div id="VisitorId">@visitorIdText</div>
<div id="VisitStartedAt">@visitStartedAtText</div>
<div id="AuthenticationId">@authenticationIdText</div>
<div id="UserName">@userNameText</div>
<div id="ApplicationName">@applicationNameText</div>
<div id="ApplicationVersion">@applicationVersionText</div>
<div id="Role1">@role1Text</div>
<div id="IsUserStoryEnabled">@marker</div>

@code {
    private LoginClient.Response? response;
    private ApplicationUser? user;
    private string marker = "true";
    private string visitorIdText = "loading";
    private string visitStartedAtText = "loading";
    private string authenticationIdText = "loading";
    private string userNameText = "loading";
    private string applicationNameText = "loading";
    private string applicationVersionText = "loading";
    private string role1Text = "loading";

    protected override async Task OnInitializedAsync() {
        user = await UserContext.GetUserAsync();
        // Preload response so marker is available immediately
        response = login.Run(new LoginClient.Request(user));
        marker = response.IsUserStoryEnabled.ToString().ToLowerInvariant();
        PopulateDisplay(user);
        StateHasChanged();
    }

    private async Task OnLoginClicked() {
        var currentUser = user ?? throw new InvalidOperationException("User context not initialized.");
        var request = new LoginClient.Request(currentUser);
        response = login.Run(request);
        marker = response.IsUserStoryEnabled.ToString().ToLowerInvariant();
        PopulateDisplay(currentUser);
    }

    private void PopulateDisplay(ApplicationUser currentUser)
    {
        visitorIdText = currentUser.Identity.VisitorId.ToString();
        visitStartedAtText = currentUser.Identity.VisitStartedAt.ToString("O");
        authenticationIdText = string.IsNullOrWhiteSpace(currentUser.Identity.AuthenticationId)
            ? currentUser.Identity.VisitorId.ToString()
            : currentUser.Identity.AuthenticationId;
        userNameText = string.IsNullOrWhiteSpace(currentUser.Identity.UserName)
            ? "Visitor"
            : currentUser.Identity.UserName;
        applicationNameText = currentUser.Application?.Name ?? "TradingPortal";
        applicationVersionText = currentUser.Application?.Version ?? "1.0";
        role1Text = currentUser.Roles.FirstOrDefault() ?? "Visitor";
    }
}
