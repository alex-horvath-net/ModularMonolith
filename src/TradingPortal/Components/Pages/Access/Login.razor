@page "/access/login"
@rendermode InteractiveServer

@using LoginClient = Experts.SecurityOfficer.Login.UserStoryBlazorClient
@using TradingPortal.Components.Pages.Access

@inject UserContext UserContext
@inject LoginClient login


<PageTitle>Login</PageTitle>

<section class="container py-4">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <p class="text-uppercase text-muted mb-1">Trading Portal</p>
            <h1 class="fw-semibold mb-0">Security Officer Login</h1>
        </div>
        <button type="button" class="btn btn-primary btn-lg" @onclick="OnLoginClicked">
            Login
        </button>
    </div>

    <div class="row gy-4">
        <div class="col-lg-6">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-body-tertiary fw-semibold">Application Context</div>
                <div class="card-body">
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted">Name</span>
                        <div id="ApplicationName" class="fw-medium">@UserContext.User.Application.Name</div>
                    </div>
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted">Version</span>
                        <div id="ApplicationVersion" class="fw-medium">@UserContext.User.Application.Version</div>
                    </div>
                    <div class="d-flex justify-content-between py-2">
                        <span class="text-muted">Primary Role</span>
                        <div id="Role1" class="fw-medium">@UserContext.User.Roles.FirstOrDefault()</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-body-tertiary fw-semibold">Visitor Session</div>
                <div class="card-body">
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted">Visitor Id</span>
                        <div id="VisitorId" class="text-break text-end">@UserContext.User.Identity.VisitorId</div>
                    </div>
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted">Visit Started</span>
                        <div id="VisitStartedAt" class="text-break text-end">@UserContext.User.Identity.VisitStartedAt</div>
                    </div>
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted">Authentication Id</span>
                        <div id="AuthenticationId" class="text-break text-end">@UserContext.User.Identity.AuthenticationId</div>
                    </div>
                    <div class="d-flex justify-content-between py-2">
                        <span class="text-muted">User Name</span>
                        <div id="UserName" class="text-break text-end">@UserContext.User.Identity.UserName</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row gy-4 mt-1">
        <div class="col-lg-6">
            <div class="card shadow-sm">
                <div class="card-header bg-body-tertiary fw-semibold">User Story Status</div>
                <div class="card-body">
                    <div class="alert alert-info mb-0 d-flex flex-column gap-1">
                        <span class="text-muted">Toggle result</span>
                        <div id="IsUserStoryEnabled" class="h4 mb-0">@response?.IsUserStoryEnabled</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private LoginClient.ClientRequest? request;
    private LoginClient.ClientResponse? response;

    override protected async Task OnInitializedAsync() {
        request = new LoginClient.ClientRequest(UserContext.User, "TestUser", "P@ssw0rd!");
    }

    private async Task OnLoginClicked() {
        response = await login.Run(request);
    }
}


