@page "/access/login"
@rendermode InteractiveServer
@using TradingPortal.Components.Pages.Access

<PageTitle>Login</PageTitle>

<h1>Login</h1>

<button type="button" class="btn btn-primary" @onclick="OnLoginClicked">Login</button>

@if (now is not null)
{
    <div class="alert alert-info mt-3" data-testid="Trader-Login-UserAction">
        @now
    </div>
}

@code {
    private DateTime? now;

    private void OnLoginClicked()
    {
        now = DateTime.UtcNow;
    }
}
