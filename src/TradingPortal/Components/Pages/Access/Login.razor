@page "/access/login"
@rendermode InteractiveServer

@using LoginClient = Experts.SecurityOfficer.Login.UserStoryBlazorClient
@using TradingPortal.Components.Pages.Access

@inject UserContext UserContext
@inject LoginClient login


<PageTitle>Login</PageTitle>

<section class="container py-5">
    <div class="row align-items-center gy-3 mb-5">
        <div class="col-lg-8">
            <p class="text-uppercase text-muted mb-2 letter-spacing">Trading Portal</p>
            <h1 class="fw-bold display-6 mb-3">Secure Access for Market Professionals</h1>
            <p class="text-secondary mb-0">Authenticate with your institutional credentials to review allocations, approvals, and risk analyses. Session telemetry updates in real time to keep compliance satisfied.</p>
        </div>
        <div class="col-lg-4 text-lg-end">
            <button type="button"
                    class="btn btn-primary btn-lg px-5"
                    @onclick="OnLoginClicked"
                    disabled="@(!CanLogin)">
                Initiate Login
            </button>
            <small class="text-muted d-block mt-2">Enter credentials to enable the control.</small>
        </div>
    </div>

    <div class="row gy-4 mb-4">
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-dark text-white fw-semibold">Application Context</div>
                <div class="card-body">
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted">Name</span>
                        <div id="ApplicationName" class="fw-medium">@UserContext.User.Application.Name</div>
                    </div>
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted">Version</span>
                        <div id="ApplicationVersion" class="fw-medium">@UserContext.User.Application.Version</div>
                    </div>
                    <div class="d-flex justify-content-between py-2">
                        <span class="text-muted">Primary Role</span>
                        <div id="Role1" class="fw-medium">@UserContext.User.Roles.FirstOrDefault()</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-dark text-white fw-semibold">Visitor Session</div>
                <div class="card-body">
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted">Visitor Id</span>
                        <div id="VisitorId" class="text-break text-end">@UserContext.User.Identity.VisitorId</div>
                    </div>
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted">Visit Started</span>
                        <div id="VisitStartedAt" class="text-break text-end">@UserContext.User.Identity.VisitStartedAt</div>
                    </div>
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted">Authentication Id</span>
                        <div id="AuthenticationId" class="text-break text-end">@UserContext.User.Identity.AuthenticationId</div>
                    </div>
                    <div class="d-flex justify-content-between py-2">
                        <span class="text-muted">User Name</span>
                        <div id="UserName" class="text-break text-end">@UserContext.User.Identity.UserName</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row gy-4 mt-2">
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-dark text-white fw-semibold">Credentials</div>
                <div class="card-body">
                    <div class="mb-4">
                        <label class="form-label text-muted" for="Email">Email</label>
                        <input id="Email"
                               class="form-control form-control-lg"
                               placeholder="institution@bank.com"
                               type="text"
                               @bind-value="request.Email"
                               @bind-value:event="oninput"
                               autocomplete="username" />
                        <small class="text-muted">Use your issued trading identity. Case sensitive.</small>
                    </div>
                    <div class="mb-2">
                        <label class="form-label text-muted" for="Password">Password</label>
                        <input id="Password"
                               class="form-control form-control-lg"
                               placeholder="••••••••"
                               type="password"
                               @bind-value="request.Password"
                               @bind-value:event="oninput"
                               autocomplete="current-password" />
                        <small class="text-muted">Multi-factor verification enforced downstream.</small>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-dark text-white fw-semibold">User Story Status</div>
                <div class="card-body d-flex flex-column gap-3">
                    <div class="alert alert-info mb-0 d-flex flex-column gap-1">
                        <span class="text-muted">Toggle result</span>
                        <div id="IsUserStoryEnabled" class="h4 mb-0">@response?.IsUserStoryEnabled</div>
                    </div>
                    <div class="d-flex align-items-center gap-2 text-muted">
                        <span class="status-dot @(response?.IsUserStoryEnabled is true ? "bg-success" : "bg-secondary")"></span>
                        <small>@(response?.IsUserStoryEnabled is true ? "Ready to redirect to secured workspace." : "Awaiting credential validation.")</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .status-dot {
        display: inline-block;
        width: 0.75rem;
        height: 0.75rem;
        border-radius: 50%;
    }
    .letter-spacing {
        letter-spacing: 0.25rem;
    }
</style>

@code {
    private LoginClient.ClientResponse? response;
    private LoginClient.ClientRequest request = null!;
    private bool CanLogin => !string.IsNullOrWhiteSpace(request.Email) && !string.IsNullOrWhiteSpace(request.Password);

    protected override void OnInitialized() {
        request = new LoginClient.ClientRequest(UserContext.User);
    }

    private async Task OnLoginClicked() {
        response = await login.Run(request);
    }
}


