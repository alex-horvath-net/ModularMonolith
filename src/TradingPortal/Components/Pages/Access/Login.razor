@page "/access/login"
@rendermode InteractiveServer
@using TradingPortal.Components.Pages.Access
@using Client = Experts.Trader.Login.UserStory.BlazorClient;

<PageTitle>Login</PageTitle>

<h1>Login</h1>

<button type="button" class="btn btn-primary" @onclick="OnLoginClicked">Login</button>

<div id="marker">@response.IsUserStoryEnabled</div>

@code {
    private Client client = new();
    private Client.Response response = null!;

    private void OnLoginClicked() {
        var request = new Client.Request();
        response = client.Run(request);
    }
}
