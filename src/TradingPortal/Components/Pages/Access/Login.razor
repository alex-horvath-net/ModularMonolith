@page "/access/login"
@rendermode InteractiveServer

@using Experts.SecurityOfficer.Login
@using TradingPortal.Components.Pages.Access

@inject User User


<PageTitle>Login</PageTitle>

<h1>Login</h1>

<button type="button" class="btn btn-primary" @onclick="OnLoginClicked">Login</button>

<div id="marker2">@User.Application.Name</div>
<div id="marker">@response?.IsUserStoryEnabled</div>

@code {
    private BlazorClient client = new();
    private BlazorClient.Response response = null!;

    private void OnLoginClicked() {
        var request = new BlazorClient.Request();
        response = client.Run(request);
    }
}
