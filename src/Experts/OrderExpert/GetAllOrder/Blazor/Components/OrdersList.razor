@page "/orders"
@using Experts.OrderExpert.Common.Business.Domain
@using Experts.OrderExpert.Shared.Business.Domain
@inject NavigationManager Nav
@inject HttpClient Http

<h3>Orders</h3>

@if (orders is null) {
    <p>Loading...</p>
} else if (orders.Count == 0) {
    <p>No orders.</p>
} else {
    <ul>
        @foreach (var o in orders) {
            <li>
                <a href="@($"/orders/{o.Id}")">Order @o.Id</a> - Customer: @o.CustomerId - Total: @o.Total
            </li>
        }
    </ul>
}

@code {
    private List<Order>? orders;

    protected override async Task OnInitializedAsync() {
        // Demo placeholder; replace with real API call when available
        orders = new();
    }
}
